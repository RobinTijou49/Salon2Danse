# Domaine servi par Caddy.
#  - local : localhost  (HTTPS auto-signé)
#  - VPS   : salon.mon-ecole.fr  (HTTPS Let's Encrypt automatique)
#  - repli sans TLS : :80
DOMAIN=localhost

# Base de données (MariaDB)
DB_NAME=salon
DB_USER=salon
DB_PASSWORD=salon_dev_password
DB_ROOT_PASSWORD=root_dev_password

# Secrets applicatifs — À CHANGER en production
JWT_SECRET=change-me-please-32-chars-minimum
QR_SIGNING_SECRET=change-me-too-for-badge-qr-codes

# Stockage fichiers (MinIO / S3)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_dev_password

# E-mails.
#  - En dev : ne rien mettre -> tout part dans Mailpit (http://localhost:8025).
#  - En prod : renseigner un vrai serveur SMTP pour envoyer aux vraies adresses.
#    Exemple Gmail (mot de passe d'application requis) :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=ton.compte@gmail.com
# SMTP_PASS=xxxx_mot_de_passe_application
# MAIL_FROM=Salon de la Danse <ton.compte@gmail.com>
