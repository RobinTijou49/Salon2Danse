# Caddy sert le front et proxifie l'API.
#  - DOMAIN = vrai domaine        -> HTTPS Let's Encrypt automatique (certificat de confiance)
#  - DOMAIN = IP + CADDY_TLS=tls internal -> HTTPS auto-signé (avertissement navigateur)
#  - DOMAIN = :80                 -> HTTP simple
{$DOMAIN:localhost} {
	{$CADDY_TLS}
	encode gzip

	# Tout ce qui commence par /api part vers l'API NestJS
	handle /api/* {
		reverse_proxy api:3000
	}

	# Le reste = le front React (SPA)
	handle {
		reverse_proxy web:80
	}
}
